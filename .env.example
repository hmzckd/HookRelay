# Set these locally; do not commit real values.
DATABASE_URL=postgres://hookrelay:replace-me@127.0.0.1:5432/hookrelay?sslmode=disable
PRODUCER_TOKEN=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-a-different-32-character-random-value
TARGET_PROFILE=demo
EXTERNAL_KEY_DIR=
DEMO_A_SECRET=replace-with-a-separate-32-character-demo-secret
DEMO_B_SECRET=replace-with-another-32-character-demo-secret
LISTEN_ADDR=127.0.0.1:8080
WORKER_CONCURRENCY=4
# Optional worker probe server. Use a different loopback port for each worker process.
WORKER_HEALTH_ADDR=
